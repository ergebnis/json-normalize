{
  "name": "ergebnis/json-normalize",
  "description": "Provides a console command for normalizing JSON documents.",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Andreas Möller",
      "email": "am@localheinz.com",
      "homepage": "https://localheinz.com"
    }
  ],
  "homepage": "https://github.com/ergebnis/json-normalize",
  "support": {
    "issues": "https://github.com/ergebnis/json-normalize/issues",
    "source": "https://github.com/ergebnis/json-normalize",
    "security": "https://github.com/ergebnis/json-normalize/blob/main/.github/SECURITY.md"
  },
  "require": {
    "php": "~7.4.0 || ~8.0.0 || ~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "ext-json": "*",
    "ergebnis/json": "^1.4.0",
    "ergebnis/json-normalizer": "^4.9.0",
    "ergebnis/json-pointer": "^3.8.0",
    "ergebnis/json-printer": "^3.7.0",
    "ergebnis/json-schema-validator": "^4.5.1",
    "justinrainbow/json-schema": "^6.10.0",
    "localheinz/diff": "^1.3.0",
    "symfony/console": "^5.4.1 || ^6.0.16 || ^7.0.0 || ^8.0.0"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.23.0",
    "ergebnis/data-provider": "^3.6.0",
    "ergebnis/license": "^2.7.0",
    "ergebnis/php-cs-fixer-config": "~6.63.1",
    "ergebnis/phpstan-rules": "^2.13.1",
    "ergebnis/phpunit-slow-test-detector": "^2.24.0",
    "ergebnis/rector-rules": "^1.18.3",
    "fakerphp/faker": "^1.24.1",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.2.2",
    "phpstan/phpstan-deprecation-rules": "^2.0.5",
    "phpstan/phpstan-phpunit": "^2.0.18",
    "phpstan/phpstan-strict-rules": "^2.0.12",
    "phpunit/phpunit": "^9.6",
    "rector/rector": "^2.5.9"
  },
  "autoload": {
    "psr-4": {
      "Ergebnis\\Json\\Normalize\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ergebnis\\Json\\Normalize\\Test\\": "test/"
    }
  },
  "bin": [
    "bin/json-normalize"
  ],
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "ergebnis/composer-normalize": true,
      "phpstan/extension-installer": true
    },
    "audit": {
      "abandoned": "report"
    },
    "platform": {
      "php": "7.4.33"
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "composer-normalize": {
      "indent-size": 2,
      "indent-style": "space"
    }
  }
}
